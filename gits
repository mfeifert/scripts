#!/usr/bin/env bash

# Run `git status --short` on select git repositories
# To set up remote tracking on bare repository, run these commands:
# dot config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
# dot fetch
# dot branch -u origin/main main

git --git-dir="${HOME}"/vc/dotfiles/ \
    --work-tree="${HOME}" \
    -c color.status=always \
    status --short --branch --ahead-behind \
| sed "s|^|dotfiles\t|"

mapfile -t dirs < "${HOME}/docs/data/gits/gits-dirs" 

for dir in "${dirs[@]}"; do
	git -C "${HOME}/${dir}" \
	    -c color.status=always \
	    status --short --branch \
	| sed "s|^|${dir}\t|"
done
